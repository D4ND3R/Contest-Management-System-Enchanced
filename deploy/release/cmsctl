#
# cmsctl is `cms ctl`. Release archives ship this wrapper next to the cms
# binary; the installer instead links /usr/local/bin/cmsctl to cms (the
# binary recognises its name).
exec "$(dirname "$(readlink -f "$0")")/cms" ctl "$@"
