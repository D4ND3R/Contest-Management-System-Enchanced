# Settings of the production Compose stack (deploy/docker-compose.yml).
# deploy/compose-init.sh copies this file to deploy/.env once; edit .env.
# No secrets here: they live in deploy/secrets/ (generated once by
# compose-init.sh).

# Images and version (published to GHCR by the release workflow).
CMS_IMAGE=ghcr.io/d4nd3r/cms
CMS_WORKER_IMAGE=ghcr.io/d4nd3r/cms-worker
CMS_VERSION=latest

# Timezone of the server (the admin Server page can change it later).
CMS_TIMEZONE=UTC

# Published ports of the three sites. Behind the Caddy profile set
# CMS_BIND=127.0.0.1 and CMS_NUM_PROXIES=1.
CMS_BIND=0.0.0.0
CMS_CONTEST_PORT=8888
CMS_ADMIN_PORT=8889
CMS_RANKING_PORT=8890
CMS_NUM_PROXIES=0

# Judge: parallel jobs (at most one per physical core reserved for judging).
CMS_WORKER_CONCURRENCY=1
# false only on development hosts without cgroups v2.
CMS_SANDBOX_CGROUPS=true

# Caddy profile (docker compose --profile caddy up -d).
CMS_DOMAIN=contest.example.org
CMS_ADMIN_DOMAIN=admin.example.org
CMS_RANKING_DOMAIN=ranking.example.org

# Where `docker compose run --rm migrate ctl backup --output /backups/` writes.
CMS_BACKUP_DIR=./backups
